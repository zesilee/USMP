{
  "name": "usmp-web",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "echo 'React 重建窗口：应用入口随脚手架 PR 恢复（openspec/changes/frontend-react-antd-switch）' && exit 1",
    "build": "echo 'React 重建窗口：应用入口随脚手架 PR 恢复（openspec/changes/frontend-react-antd-switch）' && exit 1",
    "preview": "echo 'React 重建窗口：应用入口随脚手架 PR 恢复' && exit 1",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:api": "openapi-typescript ../backend/docs/openapi/openapi3.json -o src/types/api.gen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "axios": "^1.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.61.1",
    "sass": "^1.99.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
