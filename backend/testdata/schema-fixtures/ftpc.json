{
  "module": "ftpc",
  "title": "ftpc",
  "vendor": "huawei",
  "fields": [
    {
      "path": "/ftpc/client",
      "type": "group",
      "label": "client",
      "fields": [
        {
          "path": "/ftpc/client/ipv6-vpn-instance-name",
          "type": "string",
          "label": "ipv6-vpn-instance-name",
          "minLength": 1,
          "maxLength": 31,
          "when": "../src-ipv6-addr"
        },
        {
          "path": "/ftpc/client/source-interface-name",
          "type": "string",
          "label": "source-interface-name",
          "minLength": 1,
          "maxLength": 63,
          "when": "not(../source-ipv4-address)"
        },
        {
          "path": "/ftpc/client/source-ipv4-address",
          "type": "string",
          "label": "source-ipv4-address",
          "pattern": "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%[\\p{N}\\p{L}]+)?"
        },
        {
          "path": "/ftpc/client/src-ipv6-addr",
          "type": "string",
          "label": "src-ipv6-addr",
          "pattern": "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[\\p{N}\\p{L}]+)?"
        }
      ]
    },
    {
      "path": "/ftpc/global-vpn",
      "type": "group",
      "label": "global-vpn",
      "fields": [
        {
          "path": "/ftpc/global-vpn/ipv6-vpn-name",
          "type": "string",
          "label": "ipv6-vpn-name",
          "minLength": 1,
          "maxLength": 31
        },
        {
          "path": "/ftpc/global-vpn/vpn-name",
          "type": "string",
          "label": "vpn-name",
          "minLength": 1,
          "maxLength": 31
        }
      ]
    }
  ],
  "rpcs": [
    {
      "name": "ftpc-transfer-file",
      "label": "ftpc-transfer-file",
      "input": [
        {
          "path": "command-type",
          "type": "enum",
          "label": "command-type"
        },
        {
          "path": "ipv6-vpn-name",
          "type": "string",
          "label": "ipv6-vpn-name",
          "leafRef": "/ni:network-instance/ni:instances/ni:instance/ni:name"
        },
        {
          "path": "is-public-net",
          "type": "boolean",
          "label": "is-public-net"
        },
        {
          "path": "local-file-name",
          "type": "string",
          "label": "local-file-name"
        },
        {
          "path": "password",
          "type": "string",
          "label": "password",
          "required": true
        },
        {
          "path": "remote-extension",
          "type": "string",
          "label": "remote-extension"
        },
        {
          "path": "remote-file-name",
          "type": "string",
          "label": "remote-file-name"
        },
        {
          "path": "server-ipv4-address",
          "type": "string",
          "label": "server-ipv4-address"
        },
        {
          "path": "server-ipv6-address",
          "type": "string",
          "label": "server-ipv6-address"
        },
        {
          "path": "server-port",
          "type": "number",
          "label": "server-port"
        },
        {
          "path": "source-interface-name",
          "type": "string",
          "label": "source-interface-name"
        },
        {
          "path": "source-ipv4-address",
          "type": "string",
          "label": "source-ipv4-address",
          "pattern": "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%[\\p{N}\\p{L}]+)?"
        },
        {
          "path": "source-ipv6-address",
          "type": "string",
          "label": "source-ipv6-address",
          "pattern": "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[\\p{N}\\p{L}]+)?"
        },
        {
          "path": "user-name",
          "type": "string",
          "label": "user-name",
          "required": true
        },
        {
          "path": "vpn-name",
          "type": "string",
          "label": "vpn-name",
          "leafRef": "/ni:network-instance/ni:instances/ni:instance/ni:name"
        }
      ]
    }
  ]
}
